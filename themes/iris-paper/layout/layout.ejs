<%
const layoutName = page_layout(page);
const canvas = layoutName === 'canvas';
const canvasDocument = canvas && /<html[\s>]/i.test(page.content || '');
const home = is_home();
const hasInfo = layoutName !== 'page';
const documentTitle = page.title || (is_category() ? page.category : is_tag() ? page.tag : is_archive() ? '页面一览' : config.title);
const style = page_style(page);
const cssFiles = ['base', 'fonts', 'layout', 'navigation', 'pages', 'prose', 'info', 'presets', 'tools', 'content-warning'];
%>
<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="<%= style.palette === 'ink' ? 'dark' : 'light' %>">
  <title><%= documentTitle %> · <%= config.author %></title>
  <meta name="author" content="<%= page.author || config.author %>">
  <link rel="canonical" href="<%= full_url_for(page.path || '/') %>">
  <% if (page.description || config.description) { %>
    <meta name="description" content="<%= page.description || config.description %>">
  <% } %>
  <script>document.documentElement.classList.add('js')</script>
  <script src="<%- url_for('/js/theme.js') %>"></script>
  <link rel="preload" href="<%- url_for('/fonts/MaterialSymbolsRounded.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="<%- url_for('/fonts/ChillJinshuSongPro_Regular-core.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="<%- url_for('/fonts/GenRyuMin2TW-M-core.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link href="https://fontsapi.zeoseven.com/442/main/result.css" onload="this.rel='stylesheet'" rel="preload" as="style" crossorigin />
  <noscript><link rel="stylesheet" href="https://fontsapi.zeoseven.com/442/main/result.css" /></noscript>
  <% cssFiles.forEach(function(name) { %>
    <link rel="stylesheet" href="<%- url_for('/css/' + name + '.css') %>">
  <% }); %>
  <link rel="stylesheet" href="<%- url_for('/css/compact.css') %>"<% if (!canvasDocument) { %> media="(max-width: 860px)"<% } %>>
  <% if (home) { %>
    <link rel="stylesheet" href="<%- url_for('/attachments/home/home.css') %>">
  <% } %>
  <% (page.styles ? [].concat(page.styles) : []).forEach(function(href) { %>
    <link rel="stylesheet" href="<%- url_for(href) %>">
  <% }); %>
  <script src="<%- url_for('/js/navigation.js') %>" defer></script>
  <script src="<%- url_for('/js/site-tools.js') %>" defer></script>
  <% if (content_warning(page).enabled) { %><script src="<%- url_for('/js/content-warning.js') %>" defer></script><% } %>
  <% if (hasInfo) { %><script src="<%- url_for('/js/reading.js') %>" defer></script><% } %>
</head>

<body class="<%= home ? 'is-home' : '' %>" data-layout="<%= layoutName %>" data-alignment="<%= page.alignment === 'balanced' ? 'balanced' : 'centered' %>"<% if (canvas) { %> data-canvas="<%= canvasDocument ? 'document' : 'prose' %>"<% } %><% if (style.palette) { %> data-palette="<%= style.palette %>"<% } %><% if (style.typography) { %> data-typography="<%= style.typography %>"<% } %>>
  <a class="skip-link" href="#main-content">跳转到正文</a>
  <header class="site-header">
    <% if (home) { %><%- partial('_partial/site-identity', {hero: true}) %><% } %>
    <nav class="top-nav" aria-label="站点导航">
      <% if (!home) { %><%- partial('_partial/site-identity', {hero: false}) %><% } %>
      <% if (hasInfo) { %><div class="read-progress read-progress-header" aria-hidden="true"><span></span></div><% } %>
    </nav>
  </header>
  <div class="site-layout">
    <aside class="site-rail">
      <% if (!home) { %><div class="rail-identity"><%- partial('_partial/site-identity', {hero: false}) %></div><% } %>
      <details id="site-menu" class="site-menu hover-panel" open>
        <summary id="mobile-nav" class="mobile-nav" aria-label="网站目录" aria-controls="site-menu-content"><%- partial('_partial/icon', {name: 'side_navigation'}) %></summary>
        <div id="site-menu-content" class="site-menu-body panel-body">
          <div id="site-tools-slot"><%- partial('_partial/site-tools') %></div>
          <nav aria-label="网站目录"><%- partial('_partial/navigation') %></nav>
          <%- partial('_partial/site-stats') %>
          <%- partial('_partial/social-links') %>
        </div>
      </details>
    </aside>
    <main id="main-content" tabindex="-1"><%- body %></main>
    <% if (hasInfo) { %><%- partial('_partial/post-info', {infoContent: content_warning(page).body}) %><% } %>
    <footer class="site-footer"><small>© <%= date(new Date(), 'YYYY') %> <%= config.title %></small></footer>
  </div>
  <button class="menu-backdrop" type="button" aria-label="关闭目录" tabindex="-1" hidden></button>
  <%- partial('_partial/search') %>
  <% (page.scripts ? [].concat(page.scripts) : []).forEach(function(script) { %>
    <script src="<%- url_for(script) %>" defer></script>
  <% }); %>
</body>
</html>
