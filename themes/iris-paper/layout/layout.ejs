<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title><%= page.title ? page.title + ' · ' : (is_archive() ? '归档 · ' : '') %><%= config.author %></title>
  <% if (config.description) { %>
    <meta name="description" content="<%= config.description %>">
  <% } %>
  <link rel="stylesheet" href="<%- url_for('/css/main.css') %>">
  <% (page.styles ? [].concat(page.styles) : []).forEach(function(style) { %>
    <link rel="stylesheet" href="<%- url_for(style) %>">
  <% }); %>
  <script src="<%- url_for('/js/navigation.js') %>" defer></script>
  <% if (page.layout === 'post') { %>
    <script src="<%- url_for('/js/reading.js') %>" defer></script>
  <% } %>
</head>


<body<% if (is_home() || page.layout === 'post' || page.layout === 'page' || is_archive() || is_category() || is_tag() || page.layout === 'categories') { %> class="content-layout"<% } %>>
  <a class="skip-link" href="#main-content">跳转到正文</a>

  <!-- 通栏页眉暂作占位；导航浮在上方，窄屏由 top-nav 承载整个顶栏。 -->
  <header class="site-header">
    <nav id="top-nav" class="top-nav<%= page.layout === 'post' ? ' has-post-info' : '' %>" aria-label="站点导航">
      <details id="mobile-menu" class="mobile-menu hover-panel" data-panel-mode="narrow">
        <summary id="mobile-nav" class="mobile-nav" aria-label="网站目录" aria-controls="mobile-menu-content">
          <%- partial('_partial/icon', {name: 'menu'}) %>
        </summary>
        <div id="mobile-menu-content" class="mobile-menu-body panel-body">
          <nav aria-label="网站目录">
            <%- partial('_partial/navigation') %>
          </nav>
          <%- partial('_partial/site-stats') %>
        </div>
      </details>
      <div class="site-identity">
        <a class="home-link" href="<%- url_for('/') %>"><%= config.title %></a>
        <span class="subtitle"><%= config.subtitle %></span>
      </div>
      <% if (page.layout === 'post') { %>
        <%- partial('_partial/post-info') %>
      <% } %>
    </nav>
    <nav id="side-nav" class="side-nav" aria-label="网站目录">
      <div class="side-nav-panel">
        <div class="side-nav-content">
          <%- partial('_partial/navigation') %>
        </div>
        <%- partial('_partial/site-stats') %>
      </div>
    </nav>
  </header>

  <button class="menu-backdrop" type="button" aria-label="关闭目录" tabindex="-1" hidden></button>

  <!-- main 不设版心；首页、阅读页自行选择 .page-frame。 -->
  <main id="main-content" tabindex="-1">
    <%- body %>
  </main>

  <footer class="site-footer page-frame">
    <small>© <%= date(new Date(), 'YYYY') %> <%= config.title %></small>
  </footer>

  <% (page.scripts ? [].concat(page.scripts) : []).forEach(function(script) { %>
    <script src="<%- url_for(script) %>" defer></script>
  <% }); %>
</body>
</html>
