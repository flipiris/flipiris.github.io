<% const socialItems = [
  {key: 'github', label: 'GitHub', image: '/icons/github.svg'},
  {key: 'wikidot', label: 'SCP 基金会', image: '/icons/scp-foundation.png'},
  {key: 'bangumi', label: 'Bangumi', image: '/icons/bangumi.svg'},
  {key: 'x', label: 'X', image: '/icons/x.svg'}
]; %>
<div class="social-links" aria-label="社交媒体">
  <% socialItems.forEach(function(item) { const href = theme.social && theme.social[item.key]; %>
    <% if (href) { %><a href="<%= href %>" aria-label="<%= item.label %>" title="<%= item.label %>" target="_blank" rel="noopener noreferrer"><% } else { %><button type="button" disabled aria-label="<%= item.label %>" title="<%= item.label %>：尚未设置链接"><% } %>
      <span class="social-icon social-icon-<%= item.key %>" style="--social-icon: url('<%= url_for(item.image) %>')" aria-hidden="true"></span>
    <% if (href) { %></a><% } else { %></button><% } %>
  <% }); %>
</div>
