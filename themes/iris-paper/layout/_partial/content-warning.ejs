<section class="content-warning" aria-labelledby="content-warning-title" aria-describedby="content-warning-message">
  <div class="content-warning-card">
    <h2 id="content-warning-title">内容警告</h2>
    <div id="content-warning-message" class="content-warning-message"><%- warning.message || '<p>本页含有成人内容，仅适合年满 18 周岁的读者。请确认你愿意阅读后再继续。</p>' %></div>
    <a class="content-warning-continue" href="#content-warning-body" aria-controls="content-warning-body">继续阅读</a>
    <noscript><p>未启用 JavaScript 也可阅读，确认后请选择「继续阅读」。</p></noscript>
  </div>
</section>
