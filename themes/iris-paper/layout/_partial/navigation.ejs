<%
const sections = nav_sections();
const here = url_for(page.path || '').replace(/index\.html$/, '');
const miscActive = sections.misc && here === url_for(sections.misc.path).replace(/index\.html$/, '');
const belongs = label => !!(page.categories && page.categories.toArray && page.categories.toArray().some(item => item.name === label));
%>
<ul class="nav-tree nav-primary">
  <% sections.primary.forEach(function(item) {
    const target = url_for(item.path).replace(/index\.html$/, '');
    const active = here === target || (item.path === '/tags/' && is_tag());
  %>
    <li><a href="<%- url_for(item.path) %>"<% if (active) { %> aria-current="page"<% } %>><span class="nav-label"><%= item.label %></span></a></li>
  <% }); %>
</ul>

<ul class="nav-tree nav-categories" aria-label="分类">
  <% sections.categories.forEach(function(item) {
    const active = is_category() && page.category === item.category;
    const ancestor = !active && belongs(item.category);
  %>
    <li>
      <a href="<%- url_for(item.path) %>"<% if (active) { %> aria-current="page"<% } else if (ancestor) { %> class="nav-ancestor"<% } %>>
        <%- partial('_partial/icon', {name: item.icon}) %>
        <span class="nav-label"><%= item.label %></span>
        <span class="nav-count"><%= item.count %></span>
      </a>
    </li>
  <% }); %>
  <% if (sections.misc) { %>
    <li>
      <a href="<%- url_for(sections.misc.path) %>"<% if (miscActive) { %> aria-current="page"<% } %>>
        <%- partial('_partial/icon', {name: sections.misc.icon}) %>
        <span class="nav-label"><%= sections.misc.label %></span>
        <span class="nav-count"><%= sections.misc.count %></span>
      </a>
    </li>
  <% } %>
</ul>
