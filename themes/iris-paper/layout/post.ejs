<%# 文章模板：纸张容器、阅读进度条、逐段浮现。注释块 <div class="note"> 移到信息窗第二页。 %>
<% const parts = split_note(page.content); %>
<article class="article-page page-frame">
  <header class="page-header">
    <h1><%= page.title %></h1>
  </header>

  <div class="article-content">
    <%- parts.body %>
  </div>
  <%- partial('_partial/article-footer') %>
</article>
