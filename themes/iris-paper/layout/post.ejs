<article class="article-page page-frame">
  <header class="page-header">
    <h1><%= page.title %></h1>
    <time class="article-date" datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY.MM.DD') %></time>
  </header>

  <div class="article-content">
    <%- page.content %>
  </div>
</article>
