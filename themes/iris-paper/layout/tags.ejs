<section class="archive-page page-frame" aria-labelledby="tags-title">
  <header class="page-header">
    <h1 id="tags-title">标签索引</h1>
  </header>
  <% const tags = site.tags.sort('name').toArray().filter(tag => tag.length); %>
  <% if (tags.length) { %>
    <ul class="category-list">
      <% tags.forEach(function(tag) { %>
        <li><a href="<%- url_for(tag.path) %>"><span><%= tag.name %></span><span class="category-count"><%= tag.length %> 篇</span></a></li>
      <% }); %>
    </ul>
  <% } else { %>
    <p class="empty-state">暂无标签。</p>
  <% } %>
</section>
